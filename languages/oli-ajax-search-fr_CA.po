msgid "-- Disabled"
msgstr "-- Désactivé"

msgid "Active"
msgstr "Actif"

msgid "Add a live search field to this menu."
msgstr "Ajouter un champ de recherche instantanée à ce menu."

msgid "Add to Menu"
msgstr "Ajouter au menu"

msgid "Add to cart"
msgstr "Ajouter au panier"

msgid "All product changes will be re-indexed automatically."
msgstr "Tous les changements de produits seront réindexés automatiquement."

msgid "Analytics"
msgstr "Analytique"

msgid "Analytics cleared."
msgstr "Analytique effacée."

msgid "Appearance"
msgstr "Apparence"

msgid "As a block — insert the Oli AJAX Search block in the editor."
msgstr "Comme bloc — insérez le bloc Oli AJAX Search dans l’éditeur."

msgid "As a menu item — go to the Menu Screen and add the menu item “Oli AJAX Search bar”. Done!"
msgstr "Comme élément de menu — allez à l’écran Menus et ajoutez l’élément « Barre Oli AJAX Search ». Terminé!"

msgid "As a widget — go to the Widgets Screen and choose “Oli AJAX Search bar”."
msgstr "Comme widget — allez à l’écran Widgets et choisissez « Barre Oli AJAX Search »."

msgid "Attention"
msgstr "Attention"

