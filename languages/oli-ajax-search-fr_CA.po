msgstr "Activer le planificateur"

msgid "Enable search analytics"
msgstr "Activer l’analytique de recherche"

msgid "Excerpt"
msgstr "Extrait"

msgid "Exclude"
msgstr "Exclure"

msgid "Exclude the product group from the search results or allow search only among the indicated product group."
msgstr "Exclure le groupe de produits des résultats ou n’autoriser la recherche que dans le groupe indiqué."

msgid "Exclude “out of stock” products"
msgstr "Exclure les produits « en rupture de stock »"

msgid "Exclude/include products"
msgstr "Exclure/inclure des produits"

msgid "Export CSV"
msgstr "Exporter en CSV"

msgid "Extra views"
msgstr "Vues supplémentaires"

msgid "Featured"
msgstr "En vedette"

msgid "Filtering mode"
msgstr "Mode de filtrage"

msgid "Filters"
msgstr "Filtres"

msgid "Filters that specify the product group and taxonomy that will be affected by the above mode"
msgstr "Filtres qui précisent le groupe de produits et la taxonomie concernés par le mode ci-dessus"

msgid "Fuzziness"
msgstr "Tolérance aux fautes"

