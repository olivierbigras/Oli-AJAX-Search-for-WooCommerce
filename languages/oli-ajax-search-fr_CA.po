msgstr "Avec PHP — <code>echo do_shortcode('[oli_search]');</code>"

msgid "Using a shortcode — <code>[oli_search]</code>"
msgstr "Avec un code court — <code>[oli_search]</code>"

msgid "WP-Cron maintenance"
msgstr "Maintenance WP-Cron"

msgid "WooCommerce"
msgstr "WooCommerce"

msgid "WooCommerce is required."
msgstr "WooCommerce est requis."

msgid "You are not allowed to change this setting."
msgstr "Vous n’êtes pas autorisé à modifier ce réglage."

msgid "You are not allowed to clear analytics."
msgstr "Vous n’êtes pas autorisé à effacer l’analytique."

msgid "You are not allowed to export analytics."
msgstr "Vous n’êtes pas autorisé à exporter l’analytique."

msgid "You are not allowed to rebuild the index."
msgstr "Vous n’êtes pas autorisé à reconstruire l’index."

msgid "You are not allowed to view the index."
msgstr "Vous n’êtes pas autorisé à voir l’index."

msgid "You are using the %s theme. We support common WooCommerce themes so you can easily replace all default search bars."
msgstr "Vous utilisez le thème %s. Nous prenons en charge les thèmes WooCommerce courants afin de remplacer facilement les barres de recherche par défaut."

msgid "You do not have permission to access this page."
msgstr "Vous n’avez pas la permission d’accéder à cette page."

